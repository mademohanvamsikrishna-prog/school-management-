# =============================================================================
# School Management System — Backend Environment Configuration Template
#
# INSTRUCTIONS:
#   1. Copy this file to .env in the backend/ directory
#   2. Fill in your actual values
#   3. NEVER commit the .env file — it is listed in .gitignore
#
# DATABASE POLICY:
#   - Development/Testing:  SQLite is allowed (DATABASE_URL = sqlite:///./school.db)
#   - PRODUCTION:           PostgreSQL is MANDATORY.
#                           The application will raise a RuntimeError and refuse to
#                           start if DATABASE_URL is not a PostgreSQL URL when
#                           ENVIRONMENT=production.
# =============================================================================

# Application
APP_NAME="School Management System API"
APP_VERSION="1.0.0"

# Environment: "development" | "testing" | "production"
ENVIRONMENT=development

# Debug mode (set false in production)
DEBUG=true

# =============================================================================
# Security
# CHANGE THESE IN PRODUCTION. Use a cryptographically random 64-char string.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# =============================================================================
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_OF_AT_LEAST_64_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Database
#
# Development (SQLite — local only):
#   DATABASE_URL=sqlite:///./school.db
#
# Production (PostgreSQL — REQUIRED):
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/school_db
# =============================================================================
DATABASE_URL=sqlite:///./school.db

# =============================================================================
# CORS — allowed frontend origins
#
# Comma-separated list of origins. NO wildcards (*) — they are incompatible
# with allow_credentials=True and will cause a startup error.
#
# Development (default — localhost ports auto-added by config.py):
#   CORS_ORIGINS=http://localhost:8081,http://localhost:3000
#
# Production (replace with your actual Vercel URL):
#   CORS_ORIGINS=https://your-app.vercel.app
#
# Multiple origins:
#   CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
# =============================================================================
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

