# =============================================================================
# School Management System — Frontend Environment Variables
#
# INSTRUCTIONS:
#   1. Copy this file to .env.local for local development overrides.
#   2. Set real values in the Vercel dashboard (Project → Settings → Env Vars).
#   3. NEVER commit .env or .env.local — they are in .gitignore.
#
# Vercel automatically injects variables prefixed with EXPO_PUBLIC_ into the
# Expo build at export time. They are baked into the JS bundle — do NOT put
# secrets here.
# =============================================================================

# The full base URL of your deployed FastAPI backend, including /api/v1.
# Set this in the Vercel dashboard for production.
# Example: https://school-api.onrender.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
